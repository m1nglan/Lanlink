# ============================================================
# Lanlink - n16r8 板固化配置 (16MB flash + 8MB Octal PSRAM)
# 该文件在 clean / setTarget 重新配置时会被自动应用。
# ============================================================

# --- Flash: 16MB (n16r8) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- 分区表: 自定义, 单应用 factory = 6MB (容纳 LVGL UI + 中文字库, 16MB flash) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_custom.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_custom.csv"

# --- PSRAM: 8MB Octal @80MHz (n16r8) ---
# 注: 旧记录 80MHz 位翻转(音频错字根因), 但那时的屏幕老引脚 35/36/37
#     正压着 PSRAM 的 D6/D7/DQS; 屏幕重接到 21/20/19/47/48/45 后雪花消失,
#     判断 80MHz 不稳其实是接线冲突 → 改回 80MHz, 保留 memtest 开机自检兜底
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# --- 允许 .bss 段放到 PSRAM(EXT_RAM_BSS_ATTR), 省内部 SRAM ---
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- main 任务栈增大 (修复根因: I2sMic 的 m_raw 2560B + main 的 pcm 1280B 超过默认 3584B 栈导致溢出) ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- LVGL 9.5 (SquareLine 1.6.2 导出) ---
# 不提供 lv_conf.h, LVGL 配置全走 Kconfig (menuconfig → Component config → LVGL configuration)
CONFIG_LV_CONF_SKIP=y
# ui.c 顶部 #error 要求 16bit (Kconfig 默认就是16, 显式保险)
CONFIG_LV_COLOR_DEPTH_16=y
# 用标准 malloc (CONFIG_SPIRAM_USE_MALLOC 下大块自动落 PSRAM), 替代 LVGL 内置 64KB 池
CONFIG_LV_USE_CLIB_MALLOC=y
# LV_FONT_DEFAULT (theme 初始化需要)
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
# UI 各屏用到的内置 Montserrat 字号 (12/14/16/18/26/38)
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_38=y
# LVGL 日志 (调试, 稳定后可关)
CONFIG_LV_USE_LOG=y
# ★★ 修复 chat 屏气泡「框长对了但一个字都不画」:
#   SquareLine 导出的 ui_font_ch14.c 带 .bitmap_format = 1 (= COMPRESSED),
#   而 LVGL 的压缩支持默认关闭 → lv_font_fmt_txt.c:207 走 #else 分支直接
#   `LV_LOG_WARN("Compressed fonts is used but LV_USE_FONT_COMPRESSED is not enabled")`
#   然后 return NULL —— 一个像素都不画。
#   而度量表(glyph_dsc)不受 bitmap_format 影响, 所以宽度照常算出 → 框会长、字没有。
#   (其它 7 个项目字体都是 bitmap_format = 0 明文, 所以只有聊天屏中招。)
#   ★ 另一个办法: 在 SquareLine 里取消该字体的 "Compress" 再导出 (bitmap_format 变 0),
#     那样不需要解压器、渲染也更快。两者选一即可, 不要同时做多余的事。
CONFIG_LV_USE_FONT_COMPRESSED=y
# ★ 修复 I8 索引图(小图标/logo)不显示: SW 渲染器不能直接画索引图,
#   开启后在打开时把 I8 整体解码成 ARGB8888 再画 (RGB565A8 不受影响, 仍零拷贝)
CONFIG_LV_BIN_DECODER_RAM_LOAD=y
